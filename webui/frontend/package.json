{
  "name": "os-webui",
  "version": "1.0.0",
  "description": "Operating Swarm WebUI (os-webui)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.8.4",
    "daisyui": "^5.0.0",
    "focus-trap-react": "^12.0.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.0.0",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.169.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && node scripts/bundle-budget.mjs",
    "build:demo": "vite build --mode demo && node scripts/bundle-budget.mjs",
    "serve": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/tsc-ratchet.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure:rail-chrome": "node scripts/measure-rail-chrome.mjs",
    "measure:pinned-grid": "node scripts/measure-pinned-grid.mjs",
    "measure:chat-chrome": "node scripts/measure-chat-chrome.mjs",
    "measure:badge-pill": "node scripts/measure-badge-pill-1715.mjs",
    "measure:folder-pill": "node scripts/measure-folder-pill-1704.mjs",
    "measure:top-chrome": "node scripts/measure-top-chrome.mjs",
    "measure:ci": "node scripts/measure-ci.mjs",
    "capture:organic-blobs": "node scripts/capture-1717-organic-blobs.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/jsx-no-comment-textnodes": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.12.1",
    "eslint": "^8.53.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
