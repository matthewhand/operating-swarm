# Re-include src/lib/ (the repo root .gitignore excludes all "lib/" dirs,
# which would otherwise silently ignore frontend source under src/lib/).
!src/lib/
test-results/
playwright-report/
.playwright/
e2e-screenshots/
# Scratch build of `scripts/measure-chat-chrome.mjs` (#1719/#1724). The harness
# vite-builds a probe page in here so it can hit-test the real compiled
# stylesheet in Chromium; the output is a build artefact, never source.
.chat-chrome-probe/
