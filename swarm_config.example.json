{
  "_comment": "Copy to swarm_config.json (gitignored) or ~/.config/swarm/swarm_config.json. Secrets stay in the environment / .env as ${VAR} — never paste raw keys here. See CONFIGURATION.md.",
  "llm": {
    "default": {
      "provider": "openai",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "max_tokens": "32000"
    },
    "reason": {
      "provider": "openai",
      "model": "o3-mini",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "max_tokens": "200000",
      "reasoning_effort": "high"
    },
    "local": {
      "provider": "openai",
      "model": "llama3.2:latest",
      "base_url": "http://localhost:11434/",
      "api_key": "",
      "cost": 0.1,
      "speed": 0.1,
      "intelligence": 0.1,
      "temperature": 0.0
    },
    "litellm": {
      "provider": "litellm",
      "model": "${LITELLM_MODEL}",
      "base_url": "${LITELLM_BASE_URL}",
      "api_key": "${LITELLM_API_KEY}"
    }
  },
  "settings": {
    "default_llm_profile": "default",
    "override_per_task": false,
    "task_llm_profiles": {
      "orchestration": "default",
      "auxiliary": "local",
      "delegation": "default"
    },
    "product_modes": {
      "cli": true,
      "api": false,
      "blueprint": false,
      "team": false,
      "remote": false
    }
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${ALLOWED_PATH}"
      ],
      "env": {
        "ALLOWED_PATH": "${ALLOWED_PATH}"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    }
  },
  "cli_agents": {},
  "remotes": {},
  "agent_team": {
    "members": []
  },
  "blueprints": {},
  "slashCommands": {},
  "memory": {},
  "speech": {
    "stt": {
      "source": "system",
      "base_url": "",
      "model": "",
      "api_key_env": "STT_API_KEY",
      "api_key": "${STT_API_KEY}"
    },
    "tts": {
      "source": "system",
      "base_url": "",
      "model": "",
      "api_key_env": "TTS_API_KEY",
      "api_key": "${TTS_API_KEY}"
    }
  }
}
