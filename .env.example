# =============================================================================
# Open Swarm — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit your .env.
#
# What each variable does is documented in the canonical reference:
#   CONFIGURATION.md -> "Environment Variables"
#
# Security model (secure-by-default):
#   * DJANGO_DEBUG defaults to FALSE (production mode).
#   * In production mode the server REFUSES TO START unless DJANGO_SECRET_KEY,
#     DJANGO_ALLOWED_HOSTS and API_AUTH_TOKEN are all set.
#   * Development conveniences (testuser auto-login, insecure fallbacks) are
#     only honoured when DJANGO_DEBUG=true, and are off by default even then.
# =============================================================================


# =============================================================================
# SECURITY — REQUIRED IN PRODUCTION
# =============================================================================

# Django cryptographic signing key (sessions, CSRF, password resets).
# REQUIRED when DJANGO_DEBUG is not true — the server refuses to boot without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# WARNING: keep this secret; rotating it invalidates all sessions.
DJANGO_SECRET_KEY=""

# Debug mode. Defaults to FALSE (production).
# WARNING: NEVER set to true in production — debug mode leaks stack traces,
# settings and SQL, relaxes host checks, and enables dev-only auth fallbacks.
DJANGO_DEBUG="false"

# Comma-separated hostnames the server may be addressed as.
# REQUIRED when DJANGO_DEBUG is not true — the server refuses to boot without it.
# Example: DJANGO_ALLOWED_HOSTS="example.com,www.example.com"
DJANGO_ALLOWED_HOSTS=""

# Static bearer token required for API requests (Authorization: Bearer <token>).
# REQUIRED when DJANGO_DEBUG is not true — the server REFUSES TO START without
# it so production can never silently run with API auth disabled.
# (SWARM_API_KEY is accepted as a legacy alias if API_AUTH_TOKEN is unset.)
# Optional multi-key: API_AUTH_TOKENS or SWARM_API_KEYS as comma-separated list
# (merged with the single vars). Each key gets a distinct ownership principal.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=""
# API_AUTH_TOKENS=""

# Comma-separated origins trusted for CSRF-protected (POST) requests.
# Default: http://localhost:8000,http://127.0.0.1:8000
# DJANGO_CSRF_TRUSTED_ORIGINS="https://example.com"


# =============================================================================
# SECURITY — DEVELOPMENT-ONLY FLAGS (never enable in production)
# =============================================================================

# Auto-login as a local 'testuser' account when normal login fails.
# Default: false. Only honoured when BOTH this flag AND DJANGO_DEBUG are true;
# the server raises ImproperlyConfigured if it is enabled outside debug mode.
# WARNING: this is an authentication bypass — development machines only.
ALLOW_TESTUSER_AUTOLOGIN="false"

# Password for the dev-only 'testuser' account. If unset, a random password is
# generated per server process (never hardcoded). Only used in debug mode.
# TESTUSER_PASSWORD=""

# Test-suite mode: CLI tools and blueprints short-circuit with canned output.
# WARNING: NEVER set in production — it disables real execution paths and
# safety checks. Intended exclusively for automated tests.
# SWARM_TEST_MODE="1"


# =============================================================================
# Core Server Configuration
# =============================================================================

HOST="0.0.0.0"
PORT="8000"
# DJANGO_SECRET_KEY: REQUIRED for production (DJANGO_DEBUG=False). Generate a strong random value.
# DJANGO_SECRET_KEY="your-strong-random-secret-key-here"
# For local dev only, can leave unset to use insecure fallback when DEBUG=True.
# SWARM_ALLOW_NO_AUTH=true : ONLY when an external layer fully gates the API
# (e.g. reverse proxy). docker-compose does NOT enable this by default.
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com : required in prod non-debug
# API_AUTH_TOKEN or SWARM_API_KEY : optional for built-in auth (else use ALLOW_NO_AUTH)

# Optional log levels
# DJANGO_LOG_LEVEL="INFO"
# SWARM_LOG_LEVEL="DEBUG"
# LOGLEVEL="INFO"

# Per-agent SPA chat JSON (REQ-14). Default: $SWARM_USER_DATA_DIR/chats
# One file per agent: active/<user>/<agent>.json — restore on Chat reload.
# Retention is Settings-only: auto-move to trash after N days (default 90).
# Set 0 to disable auto-archive. Empty trash is always a manual Settings action.
# SWARM_CHAT_DIR="/path/to/chats"
# SWARM_CHAT_MAX_AGE_DAYS="90"
# Composer file attach bytes (REQ-38). Metadata is Django ChatAttachment.
# SWARM_ATTACHMENTS_DIR="/path/to/attachments"

# REQ-45: where *this app* is running (SPA runtime banner). Missing = unknown
# (never fake a green sandbox). Values: bare-metal | sandbox-home | sandbox-isolated.
# Compose wires this: docker-compose.yml → sandbox-isolated; docker-compose.dev.yml
# → sandbox-home. Native harness: bare-metal. Copy uses $HOME / SWARM_SANDBOX_ROOT
# placeholders only — do not put real host paths here for the banner.
# SWARM_RUNTIME_MODE="bare-metal"
# Optional Playwright attach for Browser (this machine): Chrome DevTools URL.
# SWARM_CHROME_CDP="http://127.0.0.1:9222"


# =============================================================================
# Database Configuration (REQ-123 / #508)
# =============================================================================
# Durable happy path: local Postgres in `docker compose up` (service `postgres`).
# Cloud / any Postgres: set DATABASE_URL (wins) or POSTGRES_HOST + POSTGRES_*.
# Neon is test/CI/experiments only — never the implied default. Always-on Neon
# free-tier typically burns quota by ~day 17. See docs/DATABASE.md and
# docs/RUNBOOK_NEON_QUOTA_CRASH_LOOP.md.
#
# Placeholders only. Never commit a real password or a Neon hostname here.

# Single supported override (compose default is postgres://swarm:swarm@postgres:5432/swarm):
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME"

# Alternative to DATABASE_URL when you prefer discrete knobs:
# POSTGRES_DB="swarm"
# POSTGRES_USER="swarm"
# POSTGRES_PASSWORD="your-postgres-password"
# POSTGRES_HOST="localhost"
# POSTGRES_PORT="5432"

# SQLite is secondary: pytest, desktop (ADR-003), and tiny native demos.
# Unset DATABASE_URL / POSTGRES_HOST to use it. Compose does not default here.
# DJANGO_DATABASE="sqlite"
# DJANGO_DB_NAME="/path/to/db.sqlite3"
# SQLITE_DB_PATH="/path/to/db.sqlite3"

# Emergency: skip the startup Postgres health check (not recommended).
# SWARM_SKIP_DB_HEALTH="1"

# Redis (optional; used when configured)
# REDIS_HOST="localhost"
# REDIS_PORT="6379"


# =============================================================================
# Feature Flags
# =============================================================================

# Enable the Django admin interface (true/false). Keep false unless needed.
ENABLE_ADMIN="false"

# Enable the web user interface (true/false).
ENABLE_WEBUI="false"

# REQ-45 runtime isolation banner. Compose (this file + home bind-mounts) is
# sandbox-home. bare-metal = no container. sandbox-isolated = compose, no home
# map. Missing = unknown (do not fake green). No host paths in the value.
# SWARM_RUNTIME="sandbox-home"

# Optional integrations (all default false):
# ENABLE_MCP_SERVER="false"
# ENABLE_GITHUB_MARKETPLACE="false"
# Optional CSV scopes for marketplace discovery. Non-empty lists reject unknown
# client ?org= / ?topic= with HTTP 400. Empty org allowlist = unscoped (open).
# GITHUB_MARKETPLACE_ORG_ALLOWLIST=""
# GITHUB_MARKETPLACE_TOPICS="open-swarm-blueprint,open-swarm-mcp-template"

# User-created blueprints (Agent/Team Creator):
# Discovery (exec_module of ~/.local/share/swarm/blueprints) is OFF by default.
# SWARM_ALLOW_USER_BLUEPRINT_DISCOVERY="true"
# AST sandbox before loading user/community blueprints (default on; opt out only if needed):
# SWARM_USER_BLUEPRINT_SANDBOX="false"

# Workdir confinement (hybrid_moa / cli_* / moa --workdir):
# Per-request workdir/cwd must stay under SWARM_WORKSPACES_DIR (default:
# $XDG_DATA_HOME/…/swarm/workspaces). Relative paths are OK; absolute paths
# outside the root are rejected. For local CLI power users who need /tmp or a
# repo checkout as --workdir, explicitly opt in:
# SWARM_WORKSPACES_DIR="/var/lib/swarm/workspaces"
# ALLOW_UNRESTRICTED_WORKDIR="true"


# =============================================================================
# Core LLM / API Keys
# =============================================================================

OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# OLLAMA_BASE_URL="http://localhost:11434"
# LITELLM_API_KEY=""
# LITELLM_MODEL=""
# LITELLM_BASE_URL=""

# --- CLI Agent Fusion (cli_agent / cli_fusion / cli_map / cli_orchestrator) ---
# These blueprints shell out to your installed agentic CLIs, so each CLI must be
# installed AND authenticated on the host/container. Auth varies by CLI:
#   gemini  — GEMINI_API_KEY or GOOGLE_API_KEY (or `gemini` oauth login)
#   claude  — ANTHROPIC_API_KEY (above) or `claude` login
#   grok    — file-based login via the `grok`/`agent` CLI (no single env var)
#   codex   — OPENAI_API_KEY (above)
# GEMINI_API_KEY="your-gemini-api-key"
# GOOGLE_API_KEY="your-google-api-key"

# --- Remote harnesses (Hermes / OpenMausBot / Rakazo / nested swarm) ---
# LAN facts: Hermes ubuntu-gtx 10.0.0.36:8642; OMB Windows2 10.0.0.32:8802;
# Rakazo Windows2 API 10.0.0.32:3100 UI :5173. Do NOT point these at Fly open-litellm.
# LAN LLM for this swarm (not a remote harness): http://10.0.0.30:8000/v1
# HERMES_BASE_URL="http://10.0.0.36:8642"
# HERMES_API_KEY=""
# OMB_BASE_URL="http://10.0.0.32:8802"
# OMB_API_KEY=""
# RAKAZO_BASE_URL="http://10.0.0.32:3100"
# RAKAZO_UI_URL="http://10.0.0.32:5173"
# RAKAZO_API_KEY=""
# RAKAZO_SESSION_COOKIE=""
# Nested open-swarm (another process). Env var name only — never commit the token.
# Default catalog stub is unreachable http://127.0.0.1:9 (not this listen URL).
# SWARM_REMOTE_BASE_URL="http://127.0.0.1:9"
# SWARM_REMOTE_API_KEY=""
# Optional: SWARM_LISTEN_URL="http://127.0.0.1:8000"  # used to refuse self-nesting
# Herdr is SSH-shaped (not HTTP). Local needs no SSH vars. Remote: host + user;
# HERDR_SSH_IDENTITY is a *path* (never a private key). No baked host.
# HERDR_SSH_HOST=""
# HERDR_SSH_USER=""
# HERDR_SSH_PORT="22"
# HERDR_SSH_IDENTITY=""
# HERDR_SSH_AGENT="1"

# Speech (REQ-77): optional custom OpenAI-compat STT/TTS. Env *names* are stored
# in Settings → Speech; values stay here. Empty / unset keeps the browser/OS path.
# Do not point these at :8001 or a live LAN/Fly URL in the repo.
# STT_API_KEY=""
# TTS_API_KEY=""
# SPEECH_STT_BASE_URL=""
# SPEECH_TTS_BASE_URL=""

# Default LLM profile when none is specified for an agent (e.g., "default")
DEFAULT_LLM="default"

# Set to true to suppress dummy API key warnings.
SUPPRESS_DUMMY_KEY="false"

# Brave Search API (used by search-capable blueprints/MCP servers)
BRAVE_API_KEY="your-brave-api-key"

# GitHub token (optional; higher rate limits for marketplace discovery)
# GITHUB_TOKEN=""

# Upstream repo identity (override for forks)
# SWARM_GITHUB_REPO="matthewhand/open-swarm"
# VITE_SWARM_GITHUB_REPO="matthewhand/open-swarm"


# =============================================================================
# Blueprint-Specific Environment Variables
# =============================================================================

# -- Personal Digital Assistants Blueprint --
# WEATHER_API_KEY: API key for weather information (e.g., OpenWeatherMap)
WEATHER_API_KEY="your-weather-api-key"
# QDRANT settings for Documentation Agent:
QDRANT_URL="http://your-qdrant-domain:port"
QDRANT_API_KEY="your-qdrant-api-key"

# -- Flowise Blueprint --
FLOWISE_API_KEY="your-flowise-api-key"
FLOWISE_API_ENDPOINT="http://localhost:3000"

# -- Divine Ops and Other Blueprints --
# SERPAPI_API_KEY: API key for SerpAPI search operations.
SERPAPI_API_KEY="your-serpapi-api-key"
# WP_SITES_PATH: Filesystem path for WordPress sites used in blueprints.
WP_SITES_PATH="/path/to/wp-sites.json"

# -- Miscellaneous --
# STATEFUL_CHAT_ID_PATH: JMESPath expression for stateful chat ID extraction.
STATEFUL_CHAT_ID_PATH="/default/path/to/stateful/chat_id"
# SWARM_BLUEPRINTS: Comma-separated list of blueprint names to enable.
SWARM_BLUEPRINTS="blueprint1,blueprint2"
